{
  "name": "nova",
  "private": true,
  "version": "0.1.0",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "npm run build:main && concurrently \"vite\" \"electron .\"",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:main && tsc && vite build && electron-builder",
    "start": "electron .",
    "test:unit": "vitest run test/unit test/integration test/Security.test.ts",
    "validate:all": "tsc --noEmit && eslint src/ && npm run test:unit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "csv-parser": "^3.0.0",
    "electron-updater": "^6.1.7",
    "express": "^4.19.2",
    "jszip": "^3.10.1",
    "mammoth": "^1.7.2",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "playwright": "^1.45.3",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^5.0.5",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/jszip": "^3.4.1",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "typescript": "^5.2.2",
    "vite": "^5.3.4",
    "vitest": "^1.2.0"
  }
}
